PORT=8787
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
PUBLIC_ORIGIN=http://localhost:5173

# Optional comma-separated list of Telegram user IDs allowed to dispatch.
TELEGRAM_DISPATCHER_IDS=
# Optional path for stored jobs, linked couriers and the Telegram offset, such as ./data/kerbcue.json.
KERBCUE_DATA_FILE=
# Optional OSRM-compatible router for route distance and travel time, such as
# https://routing.openstreetmap.de/routed-bike with KERBCUE_ROUTING_PROFILE=bike.
# Leave blank to show straight-line distance only.
KERBCUE_ROUTING_URL=
KERBCUE_ROUTING_PROFILE=
