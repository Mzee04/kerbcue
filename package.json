{
  "name": "kerbcue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/src/index.ts",
    "test": "node --test server/test/*.test.ts",
    "pack": "npm run build && evenhub pack app.json dist -o kerbcue.ehpk --sdk-ver 0.0.16",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "24.10.13",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
